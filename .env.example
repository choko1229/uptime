# --- Database (Pterodactyl Database Host) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=uptime
DATABASE_USER=uptime
DATABASE_PASSWORD=changeme

# --- App ---
SECRET_KEY=changeme-generate-a-long-random-string
SESSION_COOKIE_NAME=uptime_session
# Port the app listens on (Pterodactyl injects SERVER_PORT)
PORT=8000

# --- Notifications: Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# --- PageSpeed Insights ---
PAGESPEED_API_KEY=

# --- Public site ---
SITE_TITLE=Status
