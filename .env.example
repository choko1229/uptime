# The app only needs the port it should listen on.
# Everything else (database connection, admin account, SMTP, PageSpeed key,
# site title) is configured through the app itself:
#   - Database connection: filled in via /setup the first time the app starts
#     (saved to data/database.json, not to this file)
#   - Admin login: created automatically on first setup; the generated
#     username/password are printed to the server log
#   - SMTP / PageSpeed API key / site title: set later via /admin/settings
PORT=8000
